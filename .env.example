# Production docker-compose environment variables.
# Copy to `.env` and fill in real values before `docker compose up`.

POSTGRES_USER=workload
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=workload_prod

# Generate a 64-char random string in production:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=change-me-to-a-real-64-char-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Production: leave SEED_USERS unset (or false) so test accounts are NOT created.
SEED_USERS=false

# Comma-separated list of accepted Origins for CORS.
CORS_ORIGINS=https://workload.example.com

# slowapi rate limit on the login endpoint
LOGIN_RATE_LIMIT=10/minute

LOG_LEVEL=INFO

# Port the nginx frontend exposes
WEB_PORT=80
